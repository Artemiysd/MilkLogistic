{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Delivery Planning Input",
  "type": "object",
  "required": ["depot", "vehicles", "delivery_points"],
  "properties": {
    "depot": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "id": {"type": "string"},
        "address": {"type": "string", "minLength": 1},
        "coords": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["lat", "lon"], "properties": {
              "lat": {"type": "number", "minimum": -90, "maximum": 90},
              "lon": {"type": "number", "minimum": -180, "maximum": 180}
            }}
          ]
        }
      }
    },
    "vehicles": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "capacity", "count"], "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "capacity": {"type": "number", "exclusiveMinimum": 0},
        "count": {"type": "integer", "minimum": 0},
        "restricted_to_small_streets": {"type": "boolean"}
      }}
    },
    "delivery_points": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "address", "demand"], "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "address": {"type": "string", "minLength": 1},
        "street": {"type": ["string", "null"]},
        "demand": {"type": "number", "exclusiveMinimum": 0},
        "delivery_window": {"type": ["string", "null"], "pattern": "^([01]?[0-9]|2[0-3])[-:.]([0-5][0-9])$"},
        "coords": {"type": ["object", "null"]}
      }}
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_load_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_workday_hours": {"type": "number", "exclusiveMinimum": 0},
        "one_trip_per_vehicle": {"type": "boolean"},
        "unload_time_minutes": {"type": "number", "minimum": 0},
        "restricted_streets": {"type": "array", "items": {"type": "string"}},
        "restricted_vehicle_capacity": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
