# --- База ---
POSTGRES_DB=milk
POSTGRES_USER=milk
POSTGRES_PASSWORD=milk
POSTGRES_PORT=5432

# --- Порты на хосте ---
API_PORT=8000
WEB_PORT=8080
OSRM_PORT=5000
ROUTING_PORT=8100

# --- Связка web -> api (имя сервиса внутри docker-сети) ---
API_UPSTREAM=api:8000
# как бэкенд зовёт сервис маршрутизации
ROUTING_URL=http://routing:8100

# --- Геосервис ---
# публичный демо-сервер только для разовой сборки матрицы
OSRM_BASE_URL=https://router.project-osrm.org
# свой контейнер: OSRM_BASE_URL=http://osrm:5000

# --- Бэкенд ---
DATABASE_URL=postgresql+psycopg://milk:milk@db:5432/milk

# --- Фронтенд (Vite) ---
# при сборке через nginx запросы идут на относительный /api, переменная не нужна;
# для локального `npm run dev` можно указать прямой адрес бэкенда
VITE_API_BASE_URL=http://localhost:8000
