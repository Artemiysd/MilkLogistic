# Единые переводы строк: .bat обязан быть CRLF (иначе cmd ломается), остальное — LF
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md  text eol=lf
*.conf text eol=lf
*.template text eol=lf

*.png binary
*.ico binary
*.pbf binary
*.osm.pbf binary
